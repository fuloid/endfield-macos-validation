<column background="background">
  <row padding="18" gap="12" cross="center" background="surface" window-drag="true">
    <column grow="1" gap="2">
      <text size="heading">Gryphfield</text>
      <text foreground="text_muted">Endfield on your Mac</text>
    </column>
    <button variant="ghost" size="sm" on-press="refresh" disabled="{action != 'none'}">Refresh</button>
    <button variant="secondary" size="sm" on-press="settings_open">Settings</button>
  </row>
  <separator />

  <scroll grow="1">
    <column padding="20" gap="16">
      <if test="{phase == 'checking' or phase == 'boot'}">
        <column background="surface" radius="lg" padding="18" gap="8">
          <text size="lg">Checking your setup</text>
          <text foreground="text_muted">{activity}</text>
        </column>
      </if>

      <if test="{phase == 'setup'}">
        <column background="surface" radius="lg" padding="18" gap="12">
          <text size="lg">First-run setup</text>
          <text foreground="text_muted">Everything needed for Gryphfield is inside the app. Rosetta may ask for your Mac password once.</text>
          <row gap="8" cross="center"><text grow="1">Rosetta 2</text><text>{rosetta}</text></row>
          <row gap="8" cross="center"><text grow="1">Wine prefix</text><text>{prefixReady}</text></row>
          <row gap="8" cross="center"><text grow="1">GRYPHLINK</text><text>{launcherReady}</text></row>
          <text foreground="text_muted">{activity}</text>
          <button variant="primary" on-press="setup" disabled="{action != 'none'}">Set up Gryphfield</button>
        </column>
      </if>

      <if test="{phase == 'ready' or phase == 'running'}">
        <column gap="10">
          <text size="lg">Launch</text>
          <row gap="12">
            <column background="surface" radius="lg" padding="18" gap="12" grow="1">
              <text size="lg">GRYPHLINK</text>
              <text foreground="text_muted">Sign in, install updates, and launch normally.</text>
              <button variant="primary" on-press="run_launcher" disabled="{not canRunLauncher}">Run GRYPHLINK</button>
            </column>
            <column background="surface" radius="lg" padding="18" gap="12" grow="1">
              <text size="lg">Endfield</text>
              <text foreground="text_muted">Direct launch is experimental. Open GRYPHLINK to update the game.</text>
              <button variant="secondary" on-press="run_direct" disabled="{not canRunDirect}">Run Endfield Directly</button>
            </column>
          </row>
          <if test="{not gameReady}">
            <text foreground="warning">Direct launch needs config.ini and Endfield.exe in the game folder.</text>
          </if>
          <if test="{graphics == 'dxmt'}">
            <text foreground="text_muted">For GRYPHLINK, tick "Launch with DirectX 11" before Play.</text>
          </if>
          <if test="{graphics == 'vulkan'}">
            <text foreground="text_muted">For GRYPHLINK, untick "Launch with DirectX 11".</text>
          </if>
        </column>
        <column background="surface_subtle" radius="md" padding="12" gap="4">
          <text>Session</text>
          <text>{activity}</text>
          <if test="{unityStable}"><text foreground="success">Unity stayed alive for at least 30 seconds.</text></if>
        </column>
      </if>

      <if test="{phase == 'failure'}">
        <column background="surface" radius="lg" padding="18" gap="10">
          <text size="lg">Gryphfield needs attention</text>
          <text>{errorMessage}</text>
          <button variant="secondary" on-press="refresh" disabled="{action != 'none'}">Check again</button>
        </column>
      </if>
    </column>
  </scroll>

  <separator />
  <column background="surface" padding="14" gap="9">
    <row gap="8" cross="center">
      <text grow="1" foreground="text_muted">Wine controls</text>
      <button size="sm" variant="secondary" on-press="stop_game" disabled="{not gameRunning or controlBusy}">Force stop game</button>
      <button size="sm" variant="ghost" on-press="stop_wine" disabled="{not wineRunning or controlBusy}">Stop</button>
      <button size="sm" variant="ghost" on-press="restart" disabled="{not launcherReady or controlBusy}">Restart</button>
      <button size="sm" variant="ghost" on-press="kill_wine" disabled="{not wineRunning or controlBusy}">Kill Wine</button>
    </row>
    <row gap="8" cross="center">
      <text grow="1" foreground="text_muted">Engine {engineVersion} / {modeLabel}</text>
      <button size="sm" variant="ghost" on-press="uninstall_ask" disabled="{not gameReady or wineRunning or action != 'none' or controlBusy}">Uninstall game</button>
    </row>
  </column>

  <if test="{modal == 'settings'}">
    <dialog text="Settings" width="560" on-dismiss="modal_close">
      <column padding="16" gap="12">
        <text>Graphics mode</text>
        <row gap="8">
          <button size="sm" selected="{graphics == 'dxmt'}" on-press="dxmt">DXMT</button>
          <button size="sm" selected="{graphics == 'wined3d'}" on-press="wined3d">WineD3D</button>
          <button size="sm" selected="{graphics == 'vulkan'}" on-press="vulkan">Vulkan</button>
        </row>
        <text foreground="text_muted">DXMT uses DirectX 11. Vulkan uses the game's renderer through patched MoltenVK.</text>
        <text>Extra game arguments</text>
        <text-field text="{argsEdit.text}" placeholder="Optional arguments for direct launch" on-input="args_edit" />
        <switch checked="{debugLogging}" on-toggle="toggle_debug">Detailed Wine logging (large logs)</switch>
        <switch checked="{rosettaAvx}" on-toggle="toggle_avx">Advertise AVX to Rosetta</switch>
        <separator />
        <text>Installed paths</text>
        <text foreground="text_muted">Bundled Wine</text><text>{winePath}</text><button size="sm" variant="ghost" on-press="show_wine">Show in Finder</button>
        <text foreground="text_muted">Wine prefix</text><text>{prefixPath}</text><button size="sm" variant="ghost" on-press="show_prefix">Show in Finder</button>
        <text foreground="text_muted">GRYPHLINK</text><text>{launcherPath}</text><button size="sm" variant="ghost" on-press="show_launcher">Show in Finder</button>
        <text foreground="text_muted">Endfield</text><text>{gamePath}</text><button size="sm" variant="ghost" on-press="show_game">Show in Finder</button>
        <separator />
        <button size="sm" variant="ghost" on-press="reset_ask" disabled="{wineRunning or action != 'none' or controlBusy}">Reset Wine prefix...</button>
        <row gap="8"><button variant="primary" on-press="save_settings" disabled="{settingsSaved or settingsBusy}">Save settings</button><button on-press="modal_close" disabled="{settingsBusy}">Close</button></row>
      </column>
    </dialog>
  </if>

  <if test="{modal == 'failure'}">
    <dialog text="Launch or engine error" width="520" on-dismiss="modal_close">
      <column padding="16" gap="10">
        <text>Observed code: {errorCode}</text>
        <text>{errorMessage}</text>
        <text foreground="text_muted">A matching code suggests a possible cause; it does not prove one.</text>
        <text>Observed: {diagnosticObserved}</text>
        <text foreground="text_muted">Source: {diagnosticSource}</text>
        <text>{diagnosticExplanation}</text>
        <text>{diagnosticNextStep}</text>
        <text foreground="text_muted">Wine log: {logPath}</text>
        <row gap="8"><button on-press="show_log" disabled="{not hasLog}">Open log</button><button variant="primary" on-press="modal_close">Close</button></row>
      </column>
    </dialog>
  </if>

  <if test="{modal == 'uninstall1'}">
    <dialog text="Uninstall Endfield?" width="500" on-dismiss="modal_close">
      <column padding="16" gap="10">
        <text>This removes the game folder only:</text>
        <text>{gamePath}</text>
        <row gap="8"><button on-press="modal_close">Cancel</button><button variant="secondary" on-press="uninstall_next">Continue</button></row>
      </column>
    </dialog>
  </if>
  <if test="{modal == 'uninstall2'}">
    <dialog text="Confirm game removal" width="500" on-dismiss="modal_close">
      <column padding="16" gap="10">
        <text>Second confirmation: delete Endfield game files at the path shown below?</text>
        <text>{gamePath}</text>
        <row gap="8"><button on-press="modal_close">Cancel</button><button variant="secondary" on-press="uninstall_confirm">Uninstall game</button></row>
      </column>
    </dialog>
  </if>
  <if test="{modal == 'reset1'}">
    <dialog text="Reset Wine prefix?" width="500" on-dismiss="modal_close">
      <column padding="16" gap="10">
        <text>The engine will recreate the Wine prefix.</text>
        <switch checked="{keepGameOnReset}" on-toggle="toggle_keep_game">Preserve installed game files</switch>
        <row gap="8"><button on-press="modal_close">Cancel</button><button variant="secondary" on-press="reset_next">Continue</button></row>
      </column>
    </dialog>
  </if>
  <if test="{modal == 'reset2'}">
    <dialog text="Confirm prefix reset" width="500" on-dismiss="modal_close">
      <column padding="16" gap="10">
        <text>Second confirmation: reset this prefix?</text><text>{prefixPath}</text>
        <if test="{keepGameOnReset}"><text>The game folder will be preserved.</text></if>
        <if test="{not keepGameOnReset}"><text foreground="destructive">The installed game will be removed.</text></if>
        <row gap="8"><button on-press="modal_close">Cancel</button><button variant="secondary" on-press="reset_confirm">Reset prefix</button></row>
      </column>
    </dialog>
  </if>
</column>
