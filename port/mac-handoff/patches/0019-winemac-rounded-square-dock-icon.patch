index 3961732..91cf542 100644
--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -24,6 +24,7 @@
 #import "cocoa_app.h"
 #import "cocoa_cursorclipping.h"
 #import "cocoa_event.h"
+#import "cocoa_icon_utils.h"
 #import "cocoa_window.h"
 
 #pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
@@ -1057,9 +1058,9 @@ - (void) setCursorWithFrames:(NSArray*)frames
 
     - (void) setApplicationIconFromCGImageArray:(NSArray*)images
     {
-        NSImage* nsimage = nil;
+        NSImage* nsimage = [WineIconUtils maskedAppIconFromCGImages:images];
 
-        if ([images count])
+        if (!nsimage && [images count])
         {
             NSSize bestSize = NSZeroSize;
             id image;
