+++ b/dlls/winemac.drv/Makefile.in
@@ -22,6 +22,7 @@ SOURCES = \
 	cocoa_cursorclipping.m \
 	cocoa_display.m \
 	cocoa_event.m \
+	cocoa_icon_utils.m \
 	cocoa_main.m \
 	cocoa_opengl.m \
 	cocoa_status_item.m \
