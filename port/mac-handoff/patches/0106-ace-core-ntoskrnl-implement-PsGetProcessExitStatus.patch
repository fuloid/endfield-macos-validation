From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Endfield_FineWine <noreply@github.com>
Subject: [PATCH] ntoskrnl implement PsGetProcessExitStatus


Upstream Wine 11.19 port of Endfield_FineWine cc4cefa patches/stage2-dwproton/ace-core/0006-ntoskrnl-implement-PsGetProcessExitStatus.patch.
---
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index e69e6b5..bfbe359 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -2646,6 +2646,31 @@ ULONG WINAPI PsGetProcessSessionId( PEPROCESS process )
     return process->session_id;
 }
 
+/*********************************************************************
+ *           PsGetProcessExitStatus    (NTOSKRNL.@)
+ */
+NTSTATUS WINAPI PsGetProcessExitStatus( PEPROCESS process )
+{
+    NTSTATUS status = process->info.ExitStatus, ret = STATUS_SUCCESS;
+    PROCESS_BASIC_INFORMATION info;
+    HANDLE h;
+
+    /* The creation-time snapshot can be stale; refresh until exit,
+     * when the status becomes final. */
+    if (status == STATUS_PENDING
+        && !(ret = ObOpenObjectByPointer( process, OBJ_KERNEL_HANDLE, NULL, PROCESS_QUERY_LIMITED_INFORMATION,
+                                          NULL, KernelMode, &h )))
+    {
+        if (!(ret = NtQueryInformationProcess( h, ProcessBasicInformation, &info, sizeof(info), NULL )))
+            process->info.ExitStatus = status = info.ExitStatus;
+        NtClose( h );
+    }
+    if (ret) WARN( "Error querying process %p, status %#lx.\n", process, ret );
+
+    TRACE( "%p -> %#lx\n", process, status );
+    return status;
+}
+
 /*********************************************************************
  *           PsGetProcessCreateTimeQuadPart    (NTOSKRNL.@)
  */
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
index c2b6bac..c1be9d4 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -934,7 +934,7 @@
 @ stdcall PsGetProcessCreateTimeQuadPart(ptr)
 @ stub PsGetProcessDebugPort
 @ stub PsGetProcessExitProcessCalled
-@ stub PsGetProcessExitStatus
+@ stdcall PsGetProcessExitStatus(ptr)
 @ stub PsGetProcessExitTime
 @ stdcall PsGetProcessId(ptr)
 @ stdcall PsGetProcessImageFileName(ptr)
