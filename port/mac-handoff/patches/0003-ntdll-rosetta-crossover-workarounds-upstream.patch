@@ -6868,6 +6882,36 @@ NTSTATUS WINAPI NtReadVirtualMemory( HANDLE process, const void *addr, void *buf
 }
 
 
+#ifdef __APPLE__
+/* Code written cross-process with mach_vm_write (NtWriteVirtualMemory) is not noticed by
+ * Rosetta, which keeps running the old translation. Toggle the executable bit of written
+ * executable pages from the target process to force a retranslation. */
+static void toggle_executable_pages_for_rosetta( HANDLE process, void *addr, SIZE_T size )
+{
+    static int translated = -1;
+    MEMORY_BASIC_INFORMATION info;
+    ULONG old_prot, noexec;
+    SIZE_T ret;
+
+    if (translated == -1)
+    {
+        int value = 0;
+        size_t len = sizeof(value);
+        translated = !sysctlbyname( "sysctl.proc_translated", &value, &len, NULL, 0 ) && value;
+    }
+    if (!translated || !size) return;
+
+    if (NtQueryVirtualMemory( process, addr, MemoryBasicInformation, &info, sizeof(info), &ret ) ||
+        !(info.AllocationProtect & 0xf0))
+        return;
+
+    noexec = info.AllocationProtect & ~0xf0;
+    if (!noexec) noexec = PAGE_NOACCESS;
+    if (!NtProtectVirtualMemory( process, &addr, &size, noexec, &old_prot ))
+        NtProtectVirtualMemory( process, &addr, &size, old_prot, &noexec );
+}
+#endif
