From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shxrrydw <sherrydrv@gmail.com>
Date: Thu, 17 Sep 2026 18:47:06 +0200
Subject: [PATCH] ntoskrnl.exe: Add MmCopyMemory stub.

App: Goddess of Victory: NIKKE.

Upstream Wine 11.19 port of Endfield_FineWine cc4cefa patches/stage2-dwproton/ace-core/0004-ntoskrnl.exe-Add-MmCopyMemory-stub.patch.
---
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 4010b4e..8a1462d 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -4792,6 +4792,18 @@ PVOID WINAPI PsGetProcessWow64Process(PEPROCESS process)
     return NULL;
 }
 
+/*********************************************************************
+ *           MmCopyMemory    (NTOSKRNL.@)
+ */
+NTSTATUS WINAPI MmCopyMemory(void *target, MM_COPY_ADDRESS source, SIZE_T size, ULONG flags, SIZE_T *copied)
+{
+    FIXME("target %p, source %s, size %Iu, flags %#lx, copied %p stub.\n",
+            target, wine_dbgstr_longlong(source.PhysicalAddress.QuadPart), size, flags, copied);
+
+    *copied = 0;
+    return STATUS_NOT_IMPLEMENTED;
+}
+
 /*********************************************************************
  *           MmCopyVirtualMemory    (NTOSKRNL.@)
  */
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
index 9ead5fb..c2b6bac 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
+++ b/dlls/ntoskrnl.exe/ntoskrnl.exe.spec
@@ -722,6 +722,7 @@
 @ stdcall MmBuildMdlForNonPagedPool(ptr)
 @ stub MmCanFileBeTruncated
 @ stub MmCommitSessionMappedView
+@ stdcall MmCopyMemory(ptr int64 long long ptr)
 @ stdcall MmCopyVirtualMemory(ptr ptr ptr ptr long long ptr)
 @ stub MmCreateMdl
 @ stdcall MmCreateSection(ptr long ptr ptr long long long ptr)
diff --git a/include/ddk/wdm.h b/include/ddk/wdm.h
index bce1342..2240bd5 100644
--- a/include/ddk/wdm.h
+++ b/include/ddk/wdm.h
@@ -920,6 +920,16 @@ typedef enum _DRIVER_REGKEY_TYPE {
 
 typedef LARGE_INTEGER PHYSICAL_ADDRESS, *PPHYSICAL_ADDRESS;
 
+#define MM_COPY_MEMORY_PHYSICAL           0x1
+#define MM_COPY_MEMORY_VIRTUAL            0x2
+
+typedef struct _MM_COPY_ADDRESS {
+  union {
+    PVOID            VirtualAddress;
+    PHYSICAL_ADDRESS PhysicalAddress;
+  } DUMMYUNIONNAME;
+} MM_COPY_ADDRESS, *PMM_COPY_ADDRESS;
+
 #define IO_RESOURCE_PREFERRED             0x01
 #define IO_RESOURCE_DEFAULT               0x02
 #define IO_RESOURCE_ALTERNATIVE           0x08
@@ -2003,6 +2013,7 @@ void      WINAPI MmFreeNonCachedMemory(PVOID,SIZE_T);
 PVOID     WINAPI MmAllocateNonCachedMemory(SIZE_T) __WINE_ALLOC_SIZE(1) __WINE_DEALLOC(MmFreeNonCachedMemory) __WINE_MALLOC;
 PMDL      WINAPI MmAllocatePagesForMdl(PHYSICAL_ADDRESS,PHYSICAL_ADDRESS,PHYSICAL_ADDRESS,SIZE_T);
 void      WINAPI MmBuildMdlForNonPagedPool(MDL*);
+NTSTATUS  WINAPI MmCopyMemory(void*,MM_COPY_ADDRESS,SIZE_T,ULONG,SIZE_T*);
 NTSTATUS  WINAPI MmCopyVirtualMemory(PEPROCESS,void*,PEPROCESS,void*,SIZE_T,KPROCESSOR_MODE,SIZE_T*);
 void *    WINAPI MmGetSystemRoutineAddress(UNICODE_STRING*);
 PVOID     WINAPI MmMapLockedPages(MDL*,KPROCESSOR_MODE);
