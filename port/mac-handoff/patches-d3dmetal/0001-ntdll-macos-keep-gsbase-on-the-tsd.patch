diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -38,6 +38,7 @@
 #include <sys/mman.h>
 #include <sys/wait.h>
 #include <unistd.h>
+#include <time.h>
 #include <dlfcn.h>
 #ifdef HAVE_PWD_H
 # include <pwd.h>
@@ -1943,6 +1944,42 @@
     return 0;
 }
 
+#if defined(__APPLE__) && defined(__x86_64__)
+static __thread struct tm localtime_tls;
+
+static struct tm *mac_localtime( const time_t *timep )
+{
+    return localtime_r( timep, &localtime_tls );
+}
+
+static void install_localtime_hook(void)
+{
+    struct
+    {
+        BYTE jump[8];
+        const void *target;
+    } hook = { { 0xff, 0x25, 0x02, 0, 0, 0, 0xcc, 0xcc }, mac_localtime };
+    void *func = localtime;
+    size_t page_size = sysconf( _SC_PAGESIZE );
+    ULONG_PTR page = (ULONG_PTR)func & ~(page_size - 1);
+    size_t size = ((ULONG_PTR)func + sizeof(hook) - page + page_size - 1) & ~(page_size - 1);
+
+    /* localtime() owns TSD+0x60, which holds the PEB in this variant. */
+    if (mprotect( (void *)page, size, PROT_READ | PROT_WRITE | PROT_EXEC ))
+    {
+        ERR( "cannot protect localtime entry: %s\n", strerror( errno ));
+        exit(1);
+    }
+    memcpy( func, &hook, sizeof(hook) );
+    if (mprotect( (void *)page, size, PROT_READ | PROT_EXEC ))
+    {
+        ERR( "cannot restore localtime protection: %s\n", strerror( errno ));
+        exit(1);
+    }
+}
+#endif
+
+
 /***********************************************************************
  *           start_main_thread
  */
@@ -2213,6 +2250,9 @@
     set_max_limit( RLIMIT_NICE );
 #endif
 
+#if defined(__APPLE__) && defined(__x86_64__)
+    install_localtime_hook();
+#endif
     virtual_init();
     init_environment();
 
