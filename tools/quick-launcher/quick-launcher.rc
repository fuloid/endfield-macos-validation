#include <winuser.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "quick-launcher.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Endfield Quick Launcher"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "Quick-Launcher"
      VALUE "OriginalFilename", "Quick-Launcher.exe"
      VALUE "ProductName", "Endfield Quick Launcher"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
