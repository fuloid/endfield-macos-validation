From: Gryphfield
Subject: [PATCH] Do not force the Metal layer opaque for windows composited with their alpha.

DXMT sets CAMetalLayer.opaque = true when it creates a presenter, so the alpha channel
of every swapchain is ignored and transparent pixels show black. On Windows, an app that
calls DwmEnableBlurBehindWindow (Qt does for translucent GPU windows such as GRYPHLINK,
for its rounded corners and soft edges) is composited with the alpha of its content.
Gryphfield's Wine (patch 0023) records that call as the window property
__wine_dwm_content_alpha and makes the NSWindow non-opaque; such a window now gets a
non-opaque layer too. All other windows, including the game, stay opaque.
DXMT_TRANSPARENT_WINDOWS=1 or 0 forces the layer non-opaque or opaque.

Applies to DXMT v0.80.
---
diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 5e9404d..c9a5e7e 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -144,7 +144,8 @@ public:
 
     presenter = Rc(new Presenter(pDevice->GetMTLDevice(), layer_weak_,
                                  pDevice->GetDXMTDevice().queue().cmd_library,
-                                 scale_factor, desc_.SampleDesc.Count));
+                                 scale_factor, desc_.SampleDesc.Count,
+                                 GetPropW(hWnd, L"__wine_dwm_content_alpha") != nullptr));
 
     frame_latency = kSwapchainLatency;
     present_semaphore_ = CreateSemaphore(nullptr, frame_latency,
diff --git a/src/dxmt/dxmt_presenter.cpp b/src/dxmt/dxmt_presenter.cpp
index 87624a8..75e3b19 100644
--- a/src/dxmt/dxmt_presenter.cpp
+++ b/src/dxmt/dxmt_presenter.cpp
@@ -1,5 +1,6 @@
 
 #include <algorithm>
+#include <cstdlib>
 #include "Metal.hpp"
 #include "dxmt_format.hpp"
 #include "dxmt_presenter.hpp"
@@ -8,14 +9,21 @@
 
 namespace dxmt {
 
-Presenter::Presenter(WMT::Device device, WMT::MetalLayer layer, InternalCommandLibrary &lib, float scale_factor, uint8_t sample_count) :
+Presenter::Presenter(
+    WMT::Device device, WMT::MetalLayer layer, InternalCommandLibrary &lib, float scale_factor, uint8_t sample_count,
+    bool transparent
+) :
     device_(device),
     layer_(layer),
     lib_(lib),
     sample_count_(sample_count) {
   layer_.getProps(layer_props_);
   layer_props_.device = device;
-  layer_props_.opaque = true;
+  // The layer is opaque (alpha is ignored) unless the app asked for DWM blur-behind (GRYPHLINK's launcher).
+  // DXMT_TRANSPARENT_WINDOWS=1 or 0 forces it either way.
+  if (const char *force = std::getenv("DXMT_TRANSPARENT_WINDOWS"))
+    transparent = force[0] == '1';
+  layer_props_.opaque = !transparent;
   layer_props_.display_sync_enabled = false;
   layer_props_.framebuffer_only = false; // how strangely setting it true results in worse performance
   layer_props_.contents_scale = layer_props_.contents_scale * scale_factor;
diff --git a/src/dxmt/dxmt_presenter.hpp b/src/dxmt/dxmt_presenter.hpp
index 77eb35c..0559122 100644
--- a/src/dxmt/dxmt_presenter.hpp
+++ b/src/dxmt/dxmt_presenter.hpp
@@ -26,7 +26,8 @@ struct DXMTGammaRamp {
 class Presenter : public RcObject {
 public:
   Presenter(
-      WMT::Device device, WMT::MetalLayer layer, InternalCommandLibrary &lib, float scale_factor, uint8_t sample_count
+      WMT::Device device, WMT::MetalLayer layer, InternalCommandLibrary &lib, float scale_factor, uint8_t sample_count,
+      bool transparent = false
   );
 
   bool changeLayerProperties(
